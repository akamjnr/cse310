<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PersonalTaskManager.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Personal Task Manager">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <Label
                Text="Personal Task Manager"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label
                Text="Add a task below:"
                FontSize="18"/>

            <Entry
                x:Name="TaskEntry"
                Placeholder="Enter a task"
                FontSize="18"/>

            <Editor
                x:Name="DescriptionEntry"
                Placeholder="Enter a description"
                FontSize="18"
                HeightRequest="75"
                AutoSize="TextChanges"/>

            <Button
                Text="Add Task"
                FontSize="18"
                HeightRequest="55"
                Clicked="OnAddTaskClicked"/>

            <Label
                Text="My Tasks"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0"/>

            <CollectionView
                x:Name="TaskList">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            StrokeThickness="1"
                            Padding="15"
                            Margin="0,5">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnTaskTapped"/>
                            </Border.GestureRecognizers>

                            <HorizontalStackLayout
                                Spacing="12">

                                <CheckBox
                                    IsChecked="{Binding IsCompleted}"
                                    CheckedChanged="OnTaskCompletedChanged"
                                    VerticalOptions="Center">

                                    <CheckBox.Triggers>
                                        <DataTrigger
                                            TargetType="CheckBox"
                                            Binding="{Binding IsChecked, Source={RelativeSource Self}}"
                                            Value="True">

                                            <Setter
                                                Property="Color"
                                                Value="Green"/>

                                        </DataTrigger>
                                    </CheckBox.Triggers>

                                </CheckBox>

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    VerticalOptions="Center"
                                    LineBreakMode="WordWrap"/>

                            </HorizontalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label
                        Text="No tasks yet."
                        FontSize="16"
                        HorizontalOptions="Center"/>
                </CollectionView.EmptyView>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>